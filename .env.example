# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/chatapp
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
# Origin allowed to open WebSocket connections (SEC-6)
ALLOWED_ORIGIN=http://localhost:3000

# For a directly hosted production deployment, use a real certificate and key.
# Keep both files outside the repository; never commit private keys.
# NODE_ENV=production
# TLS_CERT_PATH=/secure/path/fullchain.pem
# TLS_KEY_PATH=/secure/path/privkey.pem
# ALLOWED_ORIGIN=https://chat.example.com
